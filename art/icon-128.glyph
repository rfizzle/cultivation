# cultivation — mod icon: isolated bound wheat sheaf (32x32 native).
# Rendered to the 128x128 master with --scale-to 128 (integer 4x upscale).
# Three fanned wheat heads separated by deep open notches (closing into
# creases, then seams), cinched twine band, stalks flaring to a flat-cut
# base, a leaf sprig tucked at each foot. Harvest/Wheat-Amber ramps, rim
# light upper-left, ink outline, faint warm glow around the heads.
size: 32

legend:
  . transparent
  K ink         # #0a0a0a outline
  r #F7DF94     # rim light
  h #EDC35C     # Harvest — highlight
  a #D9A441     # Wheat Amber — midtone
  s #A87A2E     # core shadow
  d #7A5620     # deep shadow / seams
  D #5A3E14     # occlusion
  P #B8A78C     # twine highlight
  p #9C8A6E     # Pale Loam — twine
  q #6B5B44     # twine shadow
  G #A5D66A     # Sprout — leaf highlight
  g #7CB342     # Leaf Green — leaf
  e #578A28     # leaf shadow
  1 #EDC35C55   # inner glow
  2 #EDC35C2E   # outer glow

