# Cultivation — netherite scythe item sprite (16px native).
# Same silhouette as iron_scythe.glyph (shared tier-family layout): wooden
# snath on the bottom-left -> upper-right diagonal with a grip peg, curved
# blade sweeping left across the top. Blade recolored to the netherite ramp —
# dark grey-brown with a subtle warm highlight on the cutting edge.
size: 16
kind: sprite
ships: src/main/resources/assets/cultivation/textures/item/netherite_scythe.png

legend:
  . transparent
  K ink          # #0a0a0a outline
  b #a5793f      # wood rim highlight (snath top)
  h #8a5a2b      # wood light
  w #6b4420      # wood mid
  d #4a2f14      # wood dark (butt / grip peg)
  E #94806f      # netherite warm edge highlight
  L #635b5e      # netherite light
  M #4a4446      # netherite mid
  D #363134      # netherite dark
  S #272324      # netherite core shadow (socket)

