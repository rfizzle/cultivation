# cultivation — Sated effect icon (18x18, vanilla mob_effect size).
# A round warm-brown bowl brimming with golden grain, two pale steam
# wisps curling up from the surface. Brown ceramic ramp lit from the
# upper-left, semi-transparent bone steam (no outline — it reads as
# vapor over the dark HUD), ink outline on the bowl silhouette.
size: 18

legend:
  . transparent
  K ink         # #0a0a0a outline
  t #C89361     # ceramic highlight
  u #9C6B3A     # ceramic midtone
  v #6B4423     # ceramic core shadow
  e #3E2A18     # Rich Earth — occlusion / foot
  h #EDC35C     # Harvest — grain surface
  a #D9A441     # Wheat Amber — grain shadow
  S #E8E0D4AA   # bone steam, semi-transparent
  f #E8E0D466   # bone steam, faint tips

