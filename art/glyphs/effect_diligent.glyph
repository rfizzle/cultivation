# cultivation — Diligent effect icon (18x18, vanilla mob_effect size).
# A pickaxe swung down-right: grey crescent head across the top, wooden
# handle raking to the lower-left, and an amber impact star bursting at
# the striking (right) tip. Grey metal ramp lit from the upper-left,
# ink silhouette outline.
size: 18

legend:
  . transparent
  K ink         # #0a0a0a outline
  W #D8D8D8     # metal highlight
  m #A9A9A9     # metal midtone
  n #6F6F6F     # metal shadow
  o #464646     # metal deep shadow
  p #9C8A6E     # Pale Loam — handle highlight
  e #3E2A18     # Rich Earth — handle shadow
  b #E8E0D4     # bone — spark core
  h #EDC35C     # Harvest — spark arms
  a #D9A441     # Wheat Amber — spark tips

