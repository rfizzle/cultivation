# cultivation — brand glyph: bound wheat sheaf (16x16 native).
# Three plump golden wheat heads packed in a fan (center one taller),
# separated by dark seams, stalks cinched by a Pale Loam twine band at
# the waist, flaring again to a flat-cut base, with a tiny leaf sprig
# at the bottom-left. Harvest -> Wheat Amber -> shadow ramp, light
# upper-left, ink outline.
size: 16

legend:
  . transparent
  K ink         # #0a0a0a outline
  h #EDC35C     # Harvest — wheat highlight
  a #D9A441     # Wheat Amber — wheat midtone
  s #A87A2E     # wheat core shadow
  d #7A5620     # wheat deep shadow / stalk seams
  P #B8A78C     # twine highlight
  p #9C8A6E     # Pale Loam — twine
  q #6B5B44     # twine shadow
  G #A5D66A     # Sprout — leaf highlight
  g #7CB342     # Leaf Green — leaf

frame:
  ................
  .....KKKKK......
  ..KKKKhhaKKKK...
  .KhhaKhaaKhasK..
  .KahaKahaKassK..
  ..KasKhaaKssK...
  ...KadhaadasK...
  ....KahdadsK....
  ....KsahdasK....
