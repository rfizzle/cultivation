# cultivation — soil_enriched: the enriched-tilling overlay (a diamond/netherite hoe's
# permanent bonus), rendered by mod code as a translucent flat quad on vanilla
# farmland's top face. An even sparser scatter than soil_fertilized — a few small warm
# loam specks in tan/amber brown, ~93% transparent — so an enriched block reads as
# subtly richer soil without competing with the compost flecks or crack overlays it
# composes with. Specks stay off the outermost edge rows/columns so the quad tiles
# across adjacent blocks without doubling density at the seam. Code-bound (not on the
# block atlas), so no outline and no margin.
size: 16
kind: particle
ships: src/main/resources/assets/cultivation/textures/overlay/soil_enriched.png

legend:
  . transparent
  g #7A5A34A6   # warm loam (~65% alpha)
  h #9A7648A0   # amber highlight
  k #5E4224A6   # deeper warm brown

grid:
  ................
  ................
  .....g..........
  ...........h..g.
  ..g.............
  ........gk......
  ..............g.
  .....h..........
  ...g.......g....
  ...g............
  .........hg.....
  ..............k.
  ......gk........
  ...........g....
  ....k...........
  ................
