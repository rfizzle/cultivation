# Cultivation — diamond scythe item sprite (16px native).
# Same silhouette as iron_scythe.glyph (shared tier-family layout): wooden
# snath on the bottom-left -> upper-right diagonal with a grip peg, curved
# blade sweeping left across the top. Blade recolored to the diamond ramp —
# pale cyan edge glint, `diamond` base, darkening teal toward the socket core.
size: 16
kind: sprite
ships: src/main/resources/assets/cultivation/textures/item/diamond_scythe.png

legend:
  . transparent
  K ink          # #0a0a0a outline
  b #a5793f      # wood rim highlight (snath top)
  h #8a5a2b      # wood light
  w #6b4420      # wood mid
  d #4a2f14      # wood dark (butt / grip peg)
  E #b0f8f4      # diamond cutting-edge glint
  L diamond      # #4eeaed diamond light
  M #2fbdc6      # diamond mid
  D #1d8a96      # diamond dark
  S #135e68      # diamond core shadow (socket)

grid:
  ................
  .....KKKKKKKK...
  ...KKKLEMMDSK...
  ..KKLEEELMKbwK..
  .KLEEKKKKKhwK...
  .KEK....KhwK....
  .KK....KhwK.....
  ......KhwK......
  .....KhwK.......
  ....KhwK........
  ...KhwddK.......
  ..KhwKKK........
  .KwdK...........
