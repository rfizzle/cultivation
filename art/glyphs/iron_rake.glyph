# Cultivation — iron rake item sprite (16px native).
# Sibling to the iron scythe: same warm-brown wooden snath on the bottom-left ->
# upper-right diagonal and the same grey iron ramp, but the blade is replaced by
# a rake HEAD at the top — a short horizontal iron crossbar with downward tines
# (teeth), the tips catching a bright glint. Light from the top-left.
size: 16
kind: sprite
ships: src/main/resources/assets/cultivation/textures/item/iron_rake.png

legend:
  . transparent
  K ink          # #0a0a0a outline
  b #a5793f      # wood rim highlight (snath top)
  h #8a5a2b      # wood light
  w #6b4420      # wood mid
  d #4a2f14      # wood dark (butt / grip peg)
  E #ececec      # iron cutting-edge glint (tine tips)
  L #d8d8d8      # iron light
  M #a8a8a8      # iron mid
  D #707070      # iron dark
  S #4f4f4f      # iron core shadow (socket)

